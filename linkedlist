class Node:
    def __init__(self, data):  # Fixed: Added double underscores
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):  # Fixed: Added double underscores
        self.head = None

    def insert(self, data):
        newnode = Node(data)
        if self.head is None:
            self.head = newnode
        else:
            temp = self.head
            while temp.next:
                temp = temp.next
            temp.next = newnode

    def display(self):
        temp = self.head
        while temp:
            print(temp.data, end=" -> ")
            temp = temp.next
        

# Execution
l = LinkedList()
l.insert(100)
l.insert(200)
l.insert(300)
l.insert(400)
l.insert(500)
l.display()
